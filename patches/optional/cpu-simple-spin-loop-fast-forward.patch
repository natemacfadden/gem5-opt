+// ---- SPIN_FF: exact fast-forward of pure guest spin loops.
+// A loop iteration that repeats exactly (same slot/fetch/load/store stream
+// with the same data, same int/fp/cc registers at the head, no stall) is
+// measured once: what it adds to every CPU stat (head to head) and to every
+// other stat (per CPU slot, so other components' work is excluded). Then the
+// CPU tick event stops at the loop head. When a wake hook fires at tick T
+// (a write to a line the loop touches, an interrupt, a stats dump/reset or
+// a drain) it credits k whole iterations, replays the leftover slots at
+// their own ticks and reschedules the tick event at the next slot tick.
+// Off unless the CPU sets spin_fast_forward (one X86 CPU, one thread).
+#include <cstring>
+#include <functional>
+#include <map>
+#include <set>
+#include <string>
+
+#include "base/debug.hh"
+#include "base/statistics.hh"
+#include "base/stats/group.hh"
+#include "cpu/simple/spin_ff.hh"
+#include "mem/cache/base.hh"
+#include "mem/simple_mem.hh"
+#include "params/SimpleMemory.hh"
+#include "sim/root.hh"
+
+namespace gem5
+{
+namespace spin_ff
+{
+
+bool replaying = false;
+
+struct Hooks
+{
+    std::function<void(uint64_t, const std::vector<double> &)> credit;
+    std::function<void()> tickOnce;     // one slot, no reschedule
+    std::function<void(Tick)> resume;   // schedule the tick event
+    std::function<bool()> observed;     // per-instruction observers
+    statistics::Group *cpuGroup = nullptr;
+};
+Hooks hooks;
+
+struct Ctx
+{
+    ThreadContext *tc;
+    std::vector<double> cnt;  // numInst, numOp, numLoad, instCnt
+    bool intrPending;
+    bool instQEmpty;
+    Tick period;
+};
+
+namespace
+{
+
+using statistics::Info;
+using Vals = std::vector<double>;
+using Snap = std::vector<Vals>;
+
+struct Rec
+{
+    uint64_t k, a, b, c;  // k: 0 slot, 1 read, 2 write, 3 fetch
+    bool operator==(const Rec &o) const
+    { return k == o.k && a == o.a && b == o.b && c == o.c; }
+};
+
+/** Data as an exact value for <= 8 bytes, else a 64-bit FNV-1a. */
+uint64_t
+dataKey(const uint8_t *d, unsigned n)
+{
+    uint64_t h = 0;
+    if (d && n <= 8) {
+        std::memcpy(&h, d, n);
+        return h;
+    }
+    h = 1469598103934665603ULL;
+    for (unsigned i = 0; d && i < n; i++) { h ^= d[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+void
+pushDist(const statistics::DistData &d, Vals &out)
+{
+    out.push_back(d.samples); out.push_back(d.sum); out.push_back(d.squares);
+    out.push_back(d.min_val); out.push_back(d.max_val);
+    out.push_back(d.underflow); out.push_back(d.overflow);
+    out.insert(out.end(), d.cvec.begin(), d.cvec.end());
+}
+
+void
+readInfo(Info *i, Vals &out)
+{
+    using namespace statistics;
+    out.clear();
+    if (dynamic_cast<FormulaInfo *>(i))
+        return;
+    i->prepare();
+    if (auto *s = dynamic_cast<ScalarInfo *>(i)) {
+        out.push_back(s->value());
+    } else if (auto *v = dynamic_cast<VectorInfo *>(i)) {
+        const VCounter &c = v->value();
+        out.assign(c.begin(), c.end());
+    } else if (auto *v2 = dynamic_cast<Vector2dInfo *>(i)) {
+        out.assign(v2->cvec.begin(), v2->cvec.end());
+    } else if (auto *d = dynamic_cast<DistInfo *>(i)) {
+        pushDist(d->data, out);
+    } else if (auto *vd = dynamic_cast<VectorDistInfo *>(i)) {
+        for (auto &dd : vd->data)
+            pushDist(dd, out);
+    } else if (auto *sh = dynamic_cast<SparseHistInfo *>(i)) {
+        out.push_back(sh->data.samples);
+        for (auto &[k, n] : sh->data.cmap) {
+            out.push_back(k);
+            out.push_back(n);
+        }
+    }
+}
+
+std::vector<Info *> infos;
+std::vector<bool> isHost;   // host* stats are never compared
+std::vector<size_t> cpuIdx, otherIdx;
+// Some objects keep state that a skip can neither credit nor watch, so no
+// skip starts if one exists: a classic cache (per-block reference counts
+// and replacement data; a store by another CPU that stays in its own
+// cache) and a memory with a random latency (its RNG draws per access).
+bool noSkip = false;
+// Other CPUs. Ending a skip reschedules this CPU's tick event, which can
+// change its order against another CPU's tick in the same tick, and with
+// it which of the two sees the other's store first.
+std::vector<BaseCPU *> otherCpus;
+
+void
+collect(statistics::Group *g, const std::string &path)
+{
+    if (dynamic_cast<BaseCache *>(g))
+        noSkip = true;
+    if (auto *m = dynamic_cast<memory::SimpleMemory *>(g); m &&
+        static_cast<const SimpleMemoryParams &>(m->params()).latency_var)
+        noSkip = true;
+    if (auto *cpu = dynamic_cast<BaseCPU *>(g); cpu && g != hooks.cpuGroup)
+        otherCpus.push_back(cpu);
+    for (auto *i : g->getStats()) {
+        infos.push_back(i);
+        isHost.push_back((path + "." + i->name).find("host") !=
+            std::string::npos);
+    }
+    for (auto &[n, sg] : g->getStatGroups())
+        collect(sg, path.empty() ? n : path + "." + n);
+}
+
+void
+snap(const std::vector<size_t> &idx, Snap &s)
+{
+    s.resize(idx.size());
+    for (size_t n = 0; n < idx.size(); n++)
+        readInfo(infos[idx[n]], s[n]);
+}
+
+constexpr size_t MaxRec = 16384;
+
+struct Cand
+{
+    Addr head = 0;
+    bool active = false, started = false, impure = false, prevOk = false;
+    std::vector<Rec> cur, prev;
+    std::vector<RegVal> startRegs, startMisc;
+    Tick start = 0, prevLen = 0;
+    uint64_t slots = 0, prevSlots = 0, streak = 0, fails = 0, idle = 0;
+};
+Cand c;
+std::set<Addr> goodHeads;   // heads that have reached a 2-iteration streak
+// Heads whose loop can never be skipped (a stat that cannot be credited
+// changes per iteration, or an iteration takes more ticks than slots).
+// They are not measured again: measuring snapshots stats every slot.
+std::set<Addr> badHeads;
+
+bool inited = false, measuring = false, slotFull = false;
+std::vector<size_t> memIdx;
+std::set<size_t> memIdxSet;
+Snap preMem, postMem, cpuA, cpuB;
+std::map<size_t, Vals> accMem, calMem;
+Vals cntA, dCnt;
+std::set<Addr> lines;
+bool skipping = false;
+Tick skipH0 = 0, skipP = 0;
+uint64_t skipL = 0;
+std::vector<std::pair<size_t, Vals>> dCpu;
+std::vector<uint8_t> sig;   // per slot of the measured iteration: access kinds
+std::set<uint8_t> sigDone;
+
+std::vector<RegVal>
+snapRegs(ThreadContext *tc)
+{
+    std::vector<RegVal> v;
+    const auto &rc = tc->getIsaPtr()->regClasses();
+    for (auto cls : {IntRegClass, FloatRegClass, CCRegClass})
+        for (auto &id : *rc.at(cls))
+            v.push_back(tc->getReg(id));
+    return v;
+}
+
+/** Is any debug flag enabled? A skipped iteration prints nothing, so a
+ *  skip would change the trace. Enabled rather than tracing: tracing can
+ *  turn on later (--debug-start) without ending a running skip. */
+bool
+debugFlagsOn()
+{
+    struct F : debug::SimpleFlag
+    {
+        static bool on(debug::SimpleFlag *f)
+        { return static_cast<F *>(f)->_enabled; }
+    };
+    for (const auto &[name, f] : debug::allFlags()) {
+        auto *s = dynamic_cast<debug::SimpleFlag *>(f);
+        if (s && !s->isFormat() && F::on(s))
+            return true;
+    }
+    return false;
+}
+
+template <class S, class P>
+S &
+statOf(P *p)
+{
+    struct A : P
+    {
+        static S &get(P *q) { return static_cast<A *>(q)->s; }
+    };
+    return A::get(p);
+}
+
+/** Scalar/Vector/Vector2d are credited; Value functors ('f') are derived. */
+bool
+creditable(Info *i)
+{
+    using namespace statistics;
+    return !dynamic_cast<FormulaInfo *>(i) &&
+        (dynamic_cast<ScalarInfoProxy<statistics::Scalar> *>(i) ||
+         dynamic_cast<VectorInfoProxy<statistics::Vector> *>(i) ||
+         dynamic_cast<Vector2dInfoProxy<statistics::Vector2d> *>(i) ||
+         dynamic_cast<ScalarInfo *>(i));
+}
+
+void
+creditStat(size_t idx, const Vals &d, double k)
+{
+    using namespace statistics;
+    Info *i = infos[idx];
+    if (auto *p = dynamic_cast<ScalarInfoProxy<statistics::Scalar> *>(i)) {
+        if (d.size() && d[0] != 0)
+            statOf<statistics::Scalar>(p) += k * d[0];
+    } else if (auto *p =
+                   dynamic_cast<VectorInfoProxy<statistics::Vector> *>(i)) {
+        auto &s = statOf<statistics::Vector>(p);
+        for (size_t e = 0; e < d.size(); e++)
+            if (d[e] != 0)
+                s[e] += k * d[e];
+    } else if (auto *p = dynamic_cast<
+                   Vector2dInfoProxy<statistics::Vector2d> *>(i)) {
+        auto &s = statOf<statistics::Vector2d>(p);
+        size_t y = p->y;
+        for (size_t e = 0; e < d.size(); e++)
+            if (d[e] != 0)
+                s[e / y][e % y] += k * d[e];
+    }
+}
+
+void
+resetCand()
+{
+    c.started = false;
+    c.streak = 0;
+    c.cur.clear();
+    c.prev.clear();
+    c.prevOk = false;
+    measuring = false;
+}
+
+/** End a skip at curTick(). Memory writes and interrupt posts run before
+ *  the CPU tick of the same tick (exclusive); dumps/resets/drains after it. */
+void
+sync(bool inclusive)
+{
+    if (!skipping)
+        return;
+    skipping = false;
+    watching = false;
+    lines.clear();
+    resetCand();
+    EventQueue *eq = curEventQueue();
+    const Tick T = curTick();
+    const uint64_t m = T < skipH0 ? 0 :
+        (T - skipH0 + (inclusive ? skipP : skipP - 1)) / skipP;
+    uint64_t k = m / skipL, r = m % skipL;
+    // Replay a whole last iteration rather than none: credit() cannot
+    // restore per-slot state such as the instruction-count event queue's
+    // clock, which tick() sets at the start of each slot.
+    if (k && !r) {
+        k--;
+        r = skipL;
+    }
+    if (k) {
+        for (auto &[i, d] : dCpu)
+            creditStat(i, d, k);
+        for (auto &[i, d] : calMem)
+            creditStat(i, d, k);
+        hooks.credit(k, dCnt);
+    }
+    replaying = true;
+    for (uint64_t i = 0; i < r; i++) {
+        eq->setCurTick(skipH0 + (k * skipL + i) * skipP);
+        hooks.tickOnce();
+    }
+    replaying = false;
+    eq->setCurTick(T);
+    hooks.resume(skipH0 + m * skipP);
+}
+
+void
+lazyInit()
+{
+    inited = true;
+    collect(Root::root(), "");
+    warn_if(noSkip, "spin_fast_forward: classic caches or a memory with "
+            "latency_var present; spin loops will not be fast-forwarded.");
+    std::set<Info *> cpuInfos;
+    std::function<void(statistics::Group *)> rec =
+        [&](statistics::Group *g) {
+            for (auto *i : g->getStats())
+                cpuInfos.insert(i);
+            for (auto &[n, sg] : g->getStatGroups())
+                rec(sg);
+        };
+    rec(hooks.cpuGroup);
+    for (size_t i = 0; i < infos.size(); i++) {
+        if (cpuInfos.count(infos[i]))
+            cpuIdx.push_back(i);
+        else if (!isHost[i])
+            otherIdx.push_back(i);
+    }
+    statistics::registerDumpCallback([]() { sync(true); });
+    statistics::registerResetCallback([]() {
+        // Reset callbacks run after the stats were zeroed, but everything
+        // sync() credits and replays happened before the reset.
+        // An iteration being measured started from pre-reset CPU stats
+        // (cpuA), so its deltas are wrong: measure it again.
+        if (measuring) {
+            measuring = false;
+            c.streak = 0;
+        }
+        if (!skipping)
+            return;
+        sync(true);
+        // The same resets as m5.stats.reset(); the legacy list also holds
+        // stats without a name (e.g. baseStats.numInsts behind cpi/ipc).
+        Root::root()->resetStats();
+        for (auto *info : statistics::statsList())
+            info->reset();
+    });
+}
+
+bool
+arrive(const Ctx &x)
+{
+    c.idle = 0;
+    // Registers are compared only across two clean iterations: skip the
+    // snapshot after an impure one.
+    std::vector<RegVal> regs;
+    if (c.started && !c.impure)
+        regs = snapRegs(x.tc);
+    bool repeat = false;
+    if (c.started) {
+        Tick len = curTick() - c.start;
+        bool clean = !c.impure;
+        repeat = clean && c.prevOk && len == c.prevLen && c.cur == c.prev &&
+            regs == c.startRegs;
+        c.prev.swap(c.cur);
+        c.prevLen = len;
+        c.prevSlots = c.slots;
+        c.prevOk = clean;
+    }
+    c.cur.clear();
+    c.slots = 0;
+    c.impure = false;
+    c.start = curTick();
+    c.started = true;
+    c.startRegs = std::move(regs);
+
+    if (!repeat) {
+        c.streak = 0;
+        c.fails++;
+        measuring = false;
+        return false;
+    }
+    c.fails = 0;
+    c.streak++;
+    if (c.streak == 1) {
+        bool refuse = debugFlagsOn() || hooks.observed();
+        for (auto *cpu : otherCpus)
+            refuse = refuse || !cpu->switchedOut();
+        if (refuse) {
+            // Do not measure this loop again (as for badHeads below):
+            // checking again at every iteration costs more than it saves.
+            badHeads.insert(c.head);
+            c.active = false;
+            c.streak = 0;
+            return false;
+        }
+        // Misc regs (x87 TOP and status, MXCSR, ...) are compared across
+        // the measured iteration only: there are hundreds of them.
+        c.startMisc.clear();
+        if (snapMisc)
+            snapMisc(x.tc, c.startMisc);
+        // Measure the next iteration (a repeat of c.prev). The first slot
+        // of each access-kind mix gets a full snapshot of every non-CPU
+        // stat to find the memory-side stats a CPU access touches.
+        sig.assign(c.prevSlots + 1, 0);
+        size_t s = 0;
+        for (auto &r : c.prev) {
+            if (r.k == 0)
+                s++;
+            else if (s < sig.size())
+                sig[s] |= 1 << r.k;
+        }
+        snap(cpuIdx, cpuA);
+        cntA = x.cnt;
+        accMem.clear();
+        measuring = true;
+        return false;
+    }
+    if (c.streak != 2 || !measuring)
+        return false;
+    goodHeads.insert(c.head);
+    snap(cpuIdx, cpuB);
+    calMem.swap(accMem);
+    accMem.clear();
+    measuring = false;
+    std::vector<RegVal> misc;
+    if (snapMisc)
+        snapMisc(x.tc, misc);
+    if (c.prevLen != c.prevSlots * x.period || misc != c.startMisc) {
+        badHeads.insert(c.head);
+        c.active = false;
+        return false;
+    }
+    if (x.intrPending || !x.instQEmpty) {
+        c.streak = 0;
+        return false;
+    }
+    dCpu.clear();
+    bool ok = true;
+    for (size_t n = 0; n < cpuIdx.size(); n++) {
+        if (cpuA[n] == cpuB[n])
+            continue;
+        if (cpuA[n].size() != cpuB[n].size() ||
+            !creditable(infos[cpuIdx[n]]))
+            ok = false;
+        Vals d(cpuB[n].size());
+        for (size_t e = 0; e < d.size() && e < cpuA[n].size(); e++)
+            d[e] = cpuB[n][e] - cpuA[n][e];
+        dCpu.emplace_back(cpuIdx[n], std::move(d));
+    }
+    for (auto &[i, d] : calMem)
+        if (!creditable(infos[i]))
+            ok = false;
+    dCnt.assign(x.cnt.size(), 0.0);
+    for (size_t e = 0; e < x.cnt.size(); e++)
+        dCnt[e] = x.cnt[e] - cntA[e];
+    if (!ok) {
+        badHeads.insert(c.head);
+        c.active = false;
+        c.streak = 0;
+        return false;
+    }
+    lines.clear();
+    for (auto &r : c.prev) {
+        if (r.k == 0)
+            continue;
+        Addr pa = r.b, sz = r.a >> 56;
+        for (Addr l = pa & ~Addr(63); l < pa + sz; l += 64)
+            lines.insert(l);
+    }
+    watching = true;
+    skipping = true;
+    skipH0 = curTick();
+    skipP = x.period;
+    skipL = c.prevSlots;
+    return true;
+}
+
+void
+push(const Rec &r)
+{
+    // An impure iteration can never repeat, so its records are not needed.
+    if (!c.started || c.impure)
+        return;
+    if (c.cur.size() < MaxRec)
+        c.cur.push_back(r);
+    else
+        c.impure = true;
+}
