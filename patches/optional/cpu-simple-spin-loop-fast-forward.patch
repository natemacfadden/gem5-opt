+/*
+ * Spin-loop fast-forward hooks (exact skip of pure guest spin loops).
+ *
+ * A component that can change what a spinning AtomicSimpleCPU loop observes
+ * calls these *before* making the change; they end the skip first.
+ *
+ * Everything here is inline so that builds without the CPU (no ISA) still
+ * link; the CPU that sets spin_fast_forward installs the hooks.
+ */
+
+#ifndef __CPU_SIMPLE_SPIN_FF_HH__
+#define __CPU_SIMPLE_SPIN_FF_HH__
+
+#include <vector>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+class ThreadContext;
+
+namespace spin_ff
+{
+
+/** True while a spinning loop is being fast-forwarded. */
+inline bool watching = false;
+
+inline void (*memWriteHook)(Addr addr, unsigned size) = nullptr;
+inline void (*wakeHook)(bool after) = nullptr;
+
+/** Set by the ISA: append the thread's misc regs (read without side
+ *  effects) to v, for the "same state" test of a loop iteration. */
+inline void (*snapMisc)(ThreadContext *tc, std::vector<RegVal> &v) = nullptr;
+
+/** Before a write to simulated memory by anything but the spinning CPU. */
+inline void
+memWrite(Addr addr, unsigned size)
+{
+    if (watching)
+        memWriteHook(addr, size);
+}
+
+/** Before an external change to the spinning CPU's interrupt state, or
+ *  before something reads its state (after = true: an event that follows
+ *  the CPU tick of the same tick). */
+inline void
+wake(bool after = false)
+{
+    if (watching)
+        wakeHook(after);
+}
+
+} // namespace spin_ff
+} // namespace gem5
+
+#endif // __CPU_SIMPLE_SPIN_FF_HH__
