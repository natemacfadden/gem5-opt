+void
+memWriteNow(Addr addr, unsigned size)
+{
+    if (!skipping)
+        return;
+    for (Addr l = addr & ~Addr(63); l < addr + size; l += 64)
+        if (lines.count(l)) {
+            sync(false);
+            return;
+        }
+}
