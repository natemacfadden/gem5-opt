+} // anonymous namespace
+
+bool
+atHead(Addr pc, bool atMacroStart)
+{
+    return c.active && atMacroStart && pc == c.head && !replaying;
+}
+
+bool
+preSlot(const Ctx *x)
+{
+    if (replaying)
+        return false;
+    if (!inited)
+        lazyInit();
+    if (c.active) {
+        c.idle++;
+        if (x && arrive(*x))
+            return true;
+    }
+    if (measuring) {
+        uint8_t s = c.slots < sig.size() ? sig[c.slots] : 0;
+        slotFull = s && sigDone.insert(s).second;
+        snap(slotFull ? otherIdx : memIdx, preMem);
+    }
+    return false;
+}
+
+void
+postSlot(Addr pc, MicroPC upc, bool haveInst, const PCStateBase &to,
+         bool impure)
+{
+    if (replaying)
+        return;
+    if (impure)
+        c.impure = true;
+    push(Rec{0, pc, upc, haveInst});
+    if (c.started)
+        c.slots++;
+    if (measuring) {
+        const auto &idx = slotFull ? otherIdx : memIdx;
+        snap(idx, postMem);
+        for (size_t n = 0; n < idx.size(); n++) {
+            if (postMem[n] == preMem[n])
+                continue;
+            if (slotFull && memIdxSet.insert(idx[n]).second)
+                memIdx.push_back(idx[n]);
+            Vals &acc = accMem[idx[n]];
+            if (acc.size() != postMem[n].size())
+                acc.assign(postMem[n].size(), 0.0);
+            for (size_t e = 0; e < acc.size() && e < preMem[n].size(); e++)
+                acc[e] += postMem[n][e] - preMem[n][e];
+        }
+    }
+    Addr t = to.instAddr();
+    if (!noSkip && t < pc && to.microPC() == 0 && t != c.head &&
+        !badHeads.count(t) &&
+        (!c.active || c.fails >= 8 || c.idle > 2 * MaxRec ||
+         (goodHeads.count(t) && !goodHeads.count(c.head)))) {
+        measuring = false;
+        c = Cand();
+        c.head = t;
+        c.active = true;
+    }
+}
+
+void
+mem(int k, Addr va, Addr pa, const uint8_t *d, unsigned n, bool impure)
+{
+    if (replaying)
+        return;
+    if (impure)
+        c.impure = true;
+    push(Rec{(uint64_t)k, va | ((uint64_t)n << 56), pa, dataKey(d, n)});
+}
+
+void
+impureAll()
+{
+    c.impure = true;
+}
